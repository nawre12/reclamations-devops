{
  "name": "reclamations-app",
  "version": "1.0.0",
  "description": "API de gestion des réclamations (support du mini-projet DevOps)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --runInBand --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:integration:coverage": "jest --runInBand tests/integration --coverage --coverageDirectory=coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:smoke": "node scripts/smoke-test.js",
    "deploy:test": "node scripts/deploy.js",
    "rollback": "node scripts/rollback.js",
    "incident:simulate": "node scripts/incident-simulate.js",
    "security:audit": "npm audit --audit-level=high",
    "security:secrets": "node scripts/secret-scan.js",
    "verify": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 70,
        "branches": 60,
        "functions": 70,
        "lines": 70
      }
    }
  }
}
