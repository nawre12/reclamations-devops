# Exemple pour l'environnement de test (valeurs factices, aucun secret réel).
# En CI, JWT_SECRET est fourni par les variables secures du dépôt ou généré par exécution.
IMAGE=ghcr.io/<proprietaire>/<depot>:sha-<commit>
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reclamations_test
JWT_SECRET=valeur-de-test-non-production
APP_VERSION=test-local
SMOKE_BASE_URL=http://127.0.0.1:3001
